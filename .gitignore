# =============================================================================
# Unity .gitignore
# =============================================================================
# Tracked intentionally (do NOT ignore):
#   Assets/           - all source assets and scripts
#   Assets/**/*.meta  - Unity meta files (required for asset linking)
#   ProjectSettings/  - project configuration
#   Packages/         - Unity Package Manager manifest
# =============================================================================

# -----------------------------------------------------------------------------
# Unity generated directories
# -----------------------------------------------------------------------------
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Mm]emory[Cc]aptures/
[Rr]ecordings/
[Uu]ser[Ss]ettings/

# Unity asset database cache
*.pidb

# Unity crash reports and sysinfo
sysinfo.txt
crashlytics-build.properties

# Unity packaging artifacts
*.unitypackage
*.apk
*.aab
*.ipa

# -----------------------------------------------------------------------------
# Visual Studio
# -----------------------------------------------------------------------------
# Solution and project files generated by Unity
*.sln
*.csproj
*.unityproj

# VS user-specific files
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs

# VS C++ cache files
*.VC.db
*.VC.opendb

# VS debug / symbol files
*.pdb
*.mdb
*.opendb

# -----------------------------------------------------------------------------
# Visual Studio Code
# -----------------------------------------------------------------------------
.vscode/

# -----------------------------------------------------------------------------
# JetBrains Rider
# -----------------------------------------------------------------------------
.idea/
*.sln.iml

# -----------------------------------------------------------------------------
# OS-generated junk files
# -----------------------------------------------------------------------------

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~

